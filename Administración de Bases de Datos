ALTER TABLE dbo.Empleados WITH CHECK
    ADD CONSTRAINT FK_Empleados_Sucursales
    FOREIGN KEY (id_sucursal) REFERENCES dbo.Sucursales(id_sucursal);

ALTER TABLE dbo.Sucursales WITH CHECK
    ADD CONSTRAINT FK_Sucursales_Encargado
    FOREIGN KEY (id_encargado) REFERENCES dbo.Empleados(id_empleado);
GO

-- Consulta 1: empleados y la sucursal a la que pertenecen.
SELECT e.id_empleado, e.nombre AS empleado, s.nombre_sucursal, e.edad, e.correo_electronico
FROM dbo.Empleados AS e
INNER JOIN dbo.Sucursales AS s ON s.id_sucursal = e.id_sucursal
ORDER BY s.id_sucursal, e.id_empleado;

-- Consulta 2: cada sucursal y el empleado que la administra.
SELECT s.id_sucursal, s.nombre_sucursal, e.nombre AS encargado, s.ciudad, s.estado
FROM dbo.Sucursales AS s
INNER JOIN dbo.Empleados AS e ON e.id_empleado = s.id_encargado
ORDER BY s.id_sucursal;

-- Consulta 3: cantidad de empleados por sucursal.
SELECT s.nombre_sucursal, COUNT(e.id_empleado) AS total_empleados
FROM dbo.Sucursales AS s
LEFT JOIN dbo.Empleados AS e ON e.id_sucursal = s.id_sucursal
GROUP BY s.nombre_sucursal
ORDER BY total_empleados DESC, s.nombre_sucursal;

-- Consulta 4: empleados mayores de 30 aÃ±os.
SELECT e.nombre, e.edad, s.nombre_sucursal, s.ciudad
FROM dbo.Empleados AS e
INNER JOIN dbo.Sucursales AS s ON s.id_sucursal = e.id_sucursal
WHERE e.edad > 30
ORDER BY e.edad DESC, e.nombre;
GO

