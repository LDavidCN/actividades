CREATE TABLE dbo.Sucursales (
    id_sucursal       INT           NOT NULL,
    nombre_sucursal   VARCHAR(100)  NOT NULL,
    id_encargado      INT           NOT NULL,
    direccion         VARCHAR(160)  NOT NULL,
    telefono          VARCHAR(15)   NOT NULL,
    ciudad            VARCHAR(60)   NOT NULL,
    estado            VARCHAR(60)   NOT NULL,
    CONSTRAINT PK_Sucursales PRIMARY KEY (id_sucursal),
    CONSTRAINT UQ_Sucursales_nombre UNIQUE (nombre_sucursal),
    CONSTRAINT UQ_Sucursales_encargado UNIQUE (id_encargado)
);

CREATE TABLE dbo.Empleados (
    id_empleado       INT           NOT NULL,
    nombre            VARCHAR(100)  NOT NULL,
    direccion         VARCHAR(160)  NOT NULL,
    telefono          VARCHAR(15)   NOT NULL,
    edad              TINYINT       NOT NULL,
    id_sucursal       INT           NOT NULL,
    correo_electronico VARCHAR(120) NOT NULL,
    contrasena_hash   VARBINARY(32) NOT NULL,
    CONSTRAINT PK_Empleados PRIMARY KEY (id_empleado),
    CONSTRAINT UQ_Empleados_correo UNIQUE (correo_electronico),
    CONSTRAINT CK_Empleados_edad CHECK (edad BETWEEN 18 AND 70)
);
GO

