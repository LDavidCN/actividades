public sealed class GreetingForm : Form
{
    private readonly TextBox name = Ui.TextBox();

    public GreetingForm()
    {
        Ui.Configure(this, "Saludo");
        Size = new Size(720, 480);
        Controls.Add(Ui.Header("Formulario de saludo", "Ingresa tu nombre para recibir un mensaje personalizado"));
        var content = new Panel { BackColor = Color.White, Location = new Point(110, 145), Size = new Size(480, 200), BorderStyle = BorderStyle.FixedSingle };
        content.Controls.Add(new Label { Text = "Ingresa tu nombre:", AutoSize = true, Font = new Font("Segoe UI", 12, FontStyle.Bold), Location = new Point(55, 40) });
        name.Location = new Point(55, 76);
        name.Width = 370;
        content.Controls.Add(name);
        content.Controls.Add(Ui.Button("Saludar", new Point(305, 125), (_, _) => Greet()));
        Controls.Add(content);
    }

    private void Greet()
    {
        var person = name.Text.Trim();
        if (string.IsNullOrWhiteSpace(person))
        {
            MessageBox.Show("Escribe tu nombre antes de continuar.", "Dato requerido", MessageBoxButtons.OK, MessageBoxIcon.Information);
            name.Focus();
            return;
        }
        MessageBox.Show($"{person}, ¡bienvenido(a) a la aplicación!", "Saludo", MessageBoxButtons.OK, MessageBoxIcon.Information);
    }
}

public sealed class LoginForm : Form
{
    private const string AccessPassword = "A2CSharp";
    private readonly TextBox password = Ui.TextBox();

    public LoginForm()
    {
        Ui.Configure(this, "Acceso al sistema");
        Size = new Size(560, 420);
        Controls.Add(Ui.Header("Acceso al sistema", "Actividad 2 · Lenguajes de Programación III"));

        var card = new Panel { BackColor = Color.White, Size = new Size(390, 190), Location = new Point(78, 135), BorderStyle = BorderStyle.FixedSingle };
        card.Controls.Add(new Label { Text = "Contraseña de acceso", Font = new Font("Segoe UI", 12, FontStyle.Bold), AutoSize = true, Location = new Point(35, 28) });
        password.Location = new Point(35, 66);
        password.Width = 315;
        password.UseSystemPasswordChar = true;
        password.KeyDown += (_, e) => { if (e.KeyCode == Keys.Enter) Authenticate(); };
        card.Controls.Add(password);
        card.Controls.Add(Ui.Button("Ingresar", new Point(225, 115), (_, _) => Authenticate()));
        card.Controls.Add(new Label { Text = "Clave de demostración: A2CSharp", ForeColor = Color.DimGray, AutoSize = true, Location = new Point(35, 128) });
        Controls.Add(card);
    }

    private void Authenticate()
    {
        if (password.Text == AccessPassword)
        {
            Hide();
            using var main = new MainForm();
            main.ShowDialog();
            Close();
            return;
        }
        MessageBox.Show("La contraseña no es correcta.", "Acceso denegado", MessageBoxButtons.OK, MessageBoxIcon.Warning);
        password.SelectAll();
        password.Focus();
    }
}

