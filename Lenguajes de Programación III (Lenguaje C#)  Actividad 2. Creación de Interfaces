using System.Globalization;

namespace Actividad2;

public sealed class OperationsForm : Form
{
    private readonly TextBox[] values = Enumerable.Range(1, 6).Select(_ => Ui.TextBox()).ToArray();
    private readonly Label result = new() { AutoSize = false, TextAlign = ContentAlignment.MiddleCenter, Font = new Font("Segoe UI", 14, FontStyle.Bold), ForeColor = Ui.Navy, BackColor = Color.White, BorderStyle = BorderStyle.FixedSingle };

    public OperationsForm()
    {
        Ui.Configure(this, "Operaciones básicas");
        Size = new Size(900, 660);
        Controls.Add(Ui.Header("Operaciones básicas", "Ingresa seis números diferentes y elige la operación que deseas realizar"));
        var grid = new TableLayoutPanel { Location = new Point(75, 125), Size = new Size(360, 300), ColumnCount = 2, RowCount = 6, BackColor = Color.White, Padding = new Padding(25) };
        grid.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 42));
        grid.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 58));
        for (var i = 0; i < values.Length; i++)
        {
            grid.RowStyles.Add(new RowStyle(SizeType.Percent, 100F / values.Length));
            grid.Controls.Add(new Label { Text = $"Número {i + 1}:", AutoSize = true, Anchor = AnchorStyles.Left, Font = new Font("Segoe UI", 10, FontStyle.Bold) }, 0, i);
            values[i].Width = 175;
            values[i].Anchor = AnchorStyles.Left;
            grid.Controls.Add(values[i], 1, i);
        }
        Controls.Add(grid);

        var actions = new FlowLayoutPanel { Location = new Point(480, 140), Size = new Size(280, 220), FlowDirection = FlowDirection.TopDown, WrapContents = false };
        actions.Controls.Add(Ui.Button("Suma", (_, _) => Calculate(numbers => numbers.Sum())));
        actions.Controls.Add(Ui.Button("Resta", (_, _) => Calculate(numbers => numbers.Skip(1).Aggregate(numbers[0], (total, number) => total - number))));
        actions.Controls.Add(Ui.Button("Multiplicación", (_, _) => Calculate(numbers => numbers.Aggregate(1D, (total, number) => total * number))));
        actions.Controls.Add(Ui.Button("División", (_, _) => Calculate(Divide)));
        var clearButton = Ui.Button("Limpiar", (_, _) => Clear());
        clearButton.BackColor = Color.FromArgb(180, 83, 9);
        actions.Controls.Add(clearButton);
        var backButton = Ui.Button("Regresar", (_, _) => Close());
        backButton.BackColor = Color.SlateGray;
        actions.Controls.Add(backButton);
        Controls.Add(actions);
        result.Location = new Point(75, 470);
        result.Size = new Size(685, 70);
        result.Text = "Resultado: —";
        Controls.Add(result);
    }

    private void Calculate(Func<double[], double> operation)
    {
        if (!TryGetValues(out var numbers)) return;
        try
        {
            result.Text = $"Resultado: {operation(numbers):N2}";
        }
        catch (DivideByZeroException)
        {
            MessageBox.Show("No es posible dividir entre cero.", "Operación no válida", MessageBoxButtons.OK, MessageBoxIcon.Warning);
        }
    }

    private static double Divide(double[] numbers)
    {
        var total = numbers[0];
        foreach (var number in numbers.Skip(1))
        {
            if (number == 0) throw new DivideByZeroException();
            total /= number;
        }
        return total;
    }

    private bool TryGetValues(out double[] numbers)
    {
        numbers = new double[values.Length];
        for (var i = 0; i < values.Length; i++)
        {
            if (!double.TryParse(values[i].Text, NumberStyles.Float, CultureInfo.CurrentCulture, out numbers[i]))
            {
                MessageBox.Show($"Escribe un número válido en el campo Número {i + 1}.", "Dato no válido", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                values[i].Focus();
                return false;
            }
        }
        return true;
    }

    private void Clear()
    {
        foreach (var value in values) value.Clear();
        result.Text = "Resultado: —";
        values[0].Focus();
    }
}

namespace Actividad2;

public sealed class PersonalDataForm : Form
{
    private readonly TextBox firstName = Ui.TextBox();
    private readonly TextBox lastName = Ui.TextBox();
    private readonly TextBox address = Ui.TextBox(true);
    private readonly TextBox city = Ui.TextBox();
    private readonly ComboBox civilStatus = new() { DropDownStyle = ComboBoxStyle.DropDownList, Width = 260 };

    public PersonalDataForm()
    {
        Ui.Configure(this, "Datos personales");
        Size = new Size(850, 650);
        Controls.Add(Ui.Header("Datos personales", "Completa la información solicitada"));
        civilStatus.Items.AddRange(["Soltero(a)", "Casado(a)", "Divorciado(a)", "Viudo(a)"]);

        var form = new TableLayoutPanel { Location = new Point(65, 125), Size = new Size(510, 320), ColumnCount = 2, RowCount = 5, BackColor = Color.White, Padding = new Padding(24) };
        form.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 39));
        form.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 61));
        AddRow(form, 0, "Nombre:", firstName);
        AddRow(form, 1, "Apellido:", lastName);
        AddRow(form, 2, "Dirección:", address);
        AddRow(form, 3, "Ciudad:", city);
        AddRow(form, 4, "Estado civil:", civilStatus);
        Controls.Add(form);

        var presentation = new Panel { Location = new Point(605, 125), Size = new Size(170, 320), BackColor = Ui.Navy };
        presentation.Paint += (_, e) =>
        {
            e.Graphics.FillEllipse(Brushes.White, 45, 48, 80, 80);
            using var font = new Font("Segoe UI", 44, FontStyle.Bold);
            e.Graphics.DrawString("☺", font, Brushes.White, 45, 150);
        };
        presentation.Controls.Add(new Label { Text = "Tu perfil", ForeColor = Color.White, Font = new Font("Segoe UI", 14, FontStyle.Bold), AutoSize = true, Location = new Point(42, 260) });
        Controls.Add(presentation);
        Controls.Add(Ui.Button("Guardar datos", new Point(342, 480), (_, _) => Save()));
        Controls.Add(Ui.Button("Cuestionario médico", new Point(65, 480), (_, _) => new MedicalForm().ShowDialog(this)));
        Controls.Add(Ui.Button("Regresar", new Point(600, 480), (_, _) => Close(), Color.SlateGray));
    }

    private static void AddRow(TableLayoutPanel panel, int row, string label, Control input)
    {
        panel.RowStyles.Add(new RowStyle(SizeType.Percent, 20));
        panel.Controls.Add(new Label { Text = label, AutoSize = true, Anchor = AnchorStyles.Left, Font = new Font("Segoe UI", 10, FontStyle.Bold) }, 0, row);
        input.Anchor = AnchorStyles.Left;
        panel.Controls.Add(input, 1, row);
    }

    private void Save()
    {
        if (string.IsNullOrWhiteSpace(firstName.Text) || string.IsNullOrWhiteSpace(lastName.Text) || civilStatus.SelectedIndex < 0)
        {
            MessageBox.Show("Completa al menos nombre, apellido y estado civil.", "Datos incompletos", MessageBoxButtons.OK, MessageBoxIcon.Warning);
            return;
        }
        MessageBox.Show("Los datos personales se registraron correctamente.", "Registro", MessageBoxButtons.OK, MessageBoxIcon.Information);
    }
}

